{
    "name": "geoforge-feature-catalogue",
    "description": "Model for the feature catalogue format, an external interchange format for feature types",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "out",
        "src"
    ],
    "main": "./out/feature-catalogue.js",
    "module": "./out/feature-catalogue.js",
    "exports": {
        "./feature-catalogue": {
            "types": "./out/feature-catalogue.d.ts",
            "default": "./out/feature-catalogue.js"
        }
    },
    "typesVersions": {
        "*": {
            "feature-catalogue": [
                "out/feature-catalogue"
            ]
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "echo 'No build step'",
        "build:clean": "npm run clean && npm run build",
        "test": "vitest run"
    },
    "dependencies": {
    },
    "devDependencies": {
        "geoforge-language": "0.0.1",
        "langium": "~4.1.0",
        "vitest": "~3.1.3"
    },
    "volta": {
        "node": "20.19.2",
        "npm": "10.8.2"
    }
}
