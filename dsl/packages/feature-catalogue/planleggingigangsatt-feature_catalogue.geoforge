model PlanleggingIgangsatt

import builtins
import Fellesegenskaper

"ekstern kodeliste for kommunenummer
Koder med status Gyldig refererer til dagens kommuner, mens koder med status Utgått referer til utgåtte kommunenummer"
codelist Kommunenummer
  import "https://register.geonorge.no/sosi-kodelister/inndelinger/inndelingsbase/kommunenummer"
  as-dictionary
{
}

'alfanumerisk kode for nasjonalt nivå / Norge.
Avledet fra "ISO 3166 Codes for the representation of names of countries and their subdivisions"'
codelist Landkode {
  "Norge. Aktuell kode for administrativ enhet for statlig vedtatte planer"
  NO = "NO"
}

"ekstern kodeliste for type reguleringsplan (pbl. §§ 12-2 og 12-3) ihht til gjeldende lov. Angir om planen er en områdeplan eller detaljplan."
codelist RpPlantype
  import "https://register.geonorge.no/sosi-kodelister/plan/reguleringsplanforslag/rpplantype"
  as-dictionary
   {
}

"ekstern kodeliste for gjeldende pbl."
codelist Lovreferanse
  import "https://register.geonorge.no/sosi-kodelister/plan/reguleringsplanforslag/lovreferanse"
  as-dictionary

   {
}

"landsdekkende entydig og unik identifikasjon av en arealplan (pbl. §§ 6-4, 9-1, og 12-1, samt kart- og planforskriften § 9 andre og sjette ledd).

Denne identifikatoren tildeles planen når planprosessen starter, og den kan ikke endres undervegs av forslagstiller."
datatype NasjonalArealplanId {
  "kode som viser til offisiell nummerering av kommuner
Merknad: Det presiseres at kommunenummer alltid skal ha 4 siffer, dvs. eventuelt med ledende null. Kommunenummer benyttes for kobling mot en rekke andre registre som også benytter 4 siffer."
  kommunenummer?: Kommunenummer
  
  "landkode = NO anvendes kun av statlig vedtaksmyndighet"
  landkode?: Landkode
  
  "entydig identifikasjon av en plan innen vedkommende administrative enhet (pbl. §§ 9-1, 12-1, samt kart- og planforskriften § 9 andre og sjette ledd)"
  planid: CharacterString
}

"dataobjekt for igangsatt planlegging etter pbl"
feature Arealplan extends Fellesegenskaper {
  "landsdekkende entydig og unik identifikasjon av en arealplan (pbl. §§ 6-4, 9-1, og 12-1, samt kart- og planforskriften § 9 andre og sjette ledd).
  Denne identifikatoren tildeles planen når planprosessen starter, og den kan ikke endres undervegs av forslagstiller."
  nasjonalArealplanId: NasjonalArealplanId
  
  "type reguleringsplan (pbl. §§ 12-2 og 12-3)"
  plantype: RpPlantype
  
  "planens offisielle navn"
  plannavn?: CharacterString
  
  "kode for hvilken lov planen vedtas etter
  For reguleringsplanforslag og planlegging igangsatt skal lovreferanse = 6 (pbl 2008)"
    lovreferanse: Lovreferanse
  planleggingIgangsatt+: Planområde
}

"område for planlegging igangsatt etter pbl 2008.
Området skal være sammenhengende i grunnriss, men kan dekke flere vertikalnivåer"
feature Planområde extends Fellesegenskaper {
  "planens utstrekning i grunnriss uavhengig av vertikalnivå"
  geometry område: GM_Surface
}
