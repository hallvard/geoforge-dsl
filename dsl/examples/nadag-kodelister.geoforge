"oversikt over koder for stopp av boring ved utførelse av en grunnundersøkelse <engelsk>overview of codes for termination of boring in a ground investigation</engelsk>"
  codelist GeotekniskStoppkode {
  "kode for avslutning av boring i antatt berg <engelsk>code for termination of boring in presumed rock</engelsk>"
    AntattBerg
  "kode for avslutning av boring i antatt stein eller blokk <engelsk>code for termination of boring in presumed stone or block</engelsk>"
    AntattSteinBlokk
  "kode for avslutning av boring ved brudd i borstang eller borspiss <engelsk>code for termination of boring due to failure of drill rod or drill bit</engelsk>"
    BruddBorstangSpiss
  "kode for avslutning av boring ved oppnådd boredybde i berg <engelsk>code for termination of boring after assumed depth in rock</engelsk>"
    DybdeIBergOppnådd
  "kode for avslutning av boring ved oppnådd boredybde i berg større enn 3 m <engelsk>code for termination of boring after assumed depth in rock greater than 3 m</engelsk>"
    DybdeIFjellMerEnn3Meter
  "kode for avslutning av boring ved feil på borustyr <engelsk>code for termination of boring due to equipment errors</engelsk>"
    MaterialEllerMaskinFeil
  "kode for avslutning av boring ved avbrutt sondering <engelsk>code for termination of boring due to interrupted sounding</engelsk>"
    SonderingAvbrutt
  "kode for avslutning av boring i fast grunn <engelsk>code for termination of boring in firm ground</engelsk>"
    SonderingAvbruttFastGrunn
  "kode for avslutning av sondering uten stopp <engelsk>code for termination of sounding without stop</engelsk>"
    SonderingAvsluttetUtenStopp
  "kode for avslutning av boring i stein, blokk eller berg <engelsk>code for termination of boring in presumed stone, block or rock</engelsk>"
    SteinBlokkFjell
  "kode for avslutning av boring ved uspesifisert årsak <engelsk>code for termination of boring due to unspecified reasons</engelsk>"
    Uspesifisert
  "Det har blitt tatt ut en kjerneprøve på minimum 3 meter<engelsk> core drilling min 3 meter</engelsk>"
    KjerneBoringMerEnn3Meter
  "kode for avslutning av boring ved oppnådd boredybde i berg større enn 3 m og borestøv har blitt analysert <engelsk>code for termination of boring after assumed depth in rock greater than 3 m and the drill cuttings have been analysed</engelsk>"
    DybdeIFjellMerEnn3MeterMedAnalyse
}

"angir hvilket medium en boring er foretatt i\r\n\r\n<engelsk> \r\ndefine what kind of medium/material the borehole has penetrated.</engelsk>"
  codelist GjennomboretMedium {
  "berggrunn/fjell\r\n\r\n<engelsk> \r\nbedrock\r\n</engelsk>"
    Berg
  "is\r\n\r\n<engelsk> \r\nice\r\n</engelsk>"
    Is
  "luft\r\n\r\n<engelsk> \r\nair\r\n</engelsk>"
    Luft
  "løsmasse\r\n\r\n<engelsk> \r\nuncompacted material\r\n</engelsk>"
    Løsmasse
  "medium/material er ikke angitt\r\n\r\n<engelsk> \r\nmedium/material is undefined\r\n</engelsk>"
    Uspesifisert
  "vann\r\n\r\n<engelsk> \r\nwater\r\n</engelsk>"
    Vann
}

"oversikt over lagdeling og jordart for klassifisering og identifisering av grunnforhold<engelsk>overview of stratification and soil type for classification and identification of ground conditions</engelsk>"
  codelist HovedLagKlassifisering $alias="MainLayerClassification" {
  "antatt forurenset materiale<engelsk>assumed contaminated material</engelsk>"
    AntattForurensning $alias="Cs"
  "blokk (fraksjoner større enn 200 mm)<engelsk>boulders (fractions > 200 mm</engelsk>"
    Blokk $alias="Bl"
  "dy (Dy består av vannavsatte plante- og dyrerester og er en strukturløs masse)<engelsk>organic material consisting of plant and animal debris sedimented in water. The material is not showing a special structure</engelsk>"
    Dy $alias="Dy"
  "matjord <engelsk>humus</engelsk>"
    Matjord $alias="Topsoil"
  "berg<engelsk>rock</engelsk>"
    Berg $alias="B"
  "forvitret torv (Torv er mer eller mindre omvandlede planterester, klassifiseres etter von Post skala)<engelsk>weathered peat (Peat is more or less transformed plant debris and is classified according to the von Post scale)</engelsk>"
    ForvitretTorv $alias="Th"
  "oppsprukket berg<engelsk>jointed rock</engelsk>"
    OppsprukketBerg $alias="Br"
  "gytje (Gytje består av vannavsatte plante- og dyrerester og viser vanligvis organisk struktur)<engelsk>organic material consisting of plant and animal debris. The material usually shows a special structure</engelsk>"
    Gytje $alias="Gy"
  "leirblandet gytje (organisk materiale )<engelsk>organic material consisting of plant, animal debris and clay.</engelsk>"
    GytjeOgLeire $alias="GyLe"
  "humus (Humus er en fellesbetegnelse på organisk materiale i jordarter)<engelsk>common denotation of organic matter in soils</engelsk>"
    Humus $alias="Mu"
  "kull<engelsk>coal</engelsk>"
    Kull $alias="Coal"
  "leire (materiale med mer enn 30 % i leirfraksjonen < 2 µm)<engelsk>clay (material with more than 30 % in the clay fraction < 2 µm)</engelsk>"
    Leire $alias="Le"
  "annet organisk materiale<engelsk>other organic materials</engelsk>"
    AnnetOrganiskMateriale $alias="Organic"
  "Sand (fraksjoner mellom 0,063 og 2,0 mm)<engelsk>sand (fractions between  0,063 and 2,0 mm</engelsk>"
    Sand $alias="Sa"
  "silt (fraksjoner mellom 0,002 og 0,063 mm)<engelsk>silt (fractions between 0,002 and 0,063 mm</engelsk>"
    Silt $alias="Si"
  "skjellgrus<engelsk>coquina</engelsk>"
    Skjellgrus $alias="Skgr"
  "skjellsand<engelsk>shellsand</engelsk>"
    Skjellsand $alias="Sksa"
  "suldidholdig sand<engelsk>sulphide sand</engelsk>"
    SulfidholdigJord $alias="Su"
  "torv<engelsk>peat</engelsk>"
    Torv $alias="T"
  "tørrskorpe leire<engelsk>crusty clay</engelsk>"
    TørrskorpeLeire $alias="Let"
  "uspesifisert materiale<engelsk>unspecified material</engelsk>"
    UspesifisertMateriale $alias="NotSpecified"
  "fyllmasse<engelsk>fill mass</engelsk>"
    Fyllmasse $alias="F"
  "grus (fraksjoner mellom 2,0 og 63 mm)<engelsk>gravel (fractions between 2,0 and 63 mm</engelsk>"
    Grus $alias="Gr"
  "kvikkleire (omrørt skjærfasthet < 0,5 kPa)<engelsk>quick clay (remoulded shear strength < 0,5 kPa)</engelsk>"
    Kvikkleire $alias="kLe"
  "morene<engelsk>glacial deposit</engelsk>"
    Morene $alias="Mn"
  "friksjonsjord<engelsk>non-cohesive soil </engelsk>"
    Friksjonsjord $alias="Fr"
  Kohesjonsjord $alias="Cohesive"
  "planterester<engelsk>plant remnants</engelsk>"
    Planterester $alias="Vx"
  "Blokkig og steinig morene <engelsk>Boulder and Cobble till </engelsk>"
    BlokkigOgSteinigMorene $alias="BlMn"
  "Ukjent materiale <engelsk>Unknown material</engelsk>"
    UkjentMateriale $alias="X"
  "Jord<engelsk>soil</engelsk>"
    Jord $alias="J"
  "Steinig morene<engelsk>Cobble till</engelsk>"
    SteinigMorene $alias="StMn"
  "Grussig morene<engelsk>Gravel till</engelsk>"
    GrusigMorene $alias="GrMn"
  "Sandig morene<engelsk>Sand till</engelsk>"
    SandigMorene $alias="SaMn"
  "Siltig morene<engelsk>Silt till</engelsk>"
    SiltigMorene $alias="SiMn"
  "Leirig morene<engelsk>Clay till</engelsk>"
    LeirigMorene $alias="LeMn"
  "Skjell<engelsk>Shells</engelsk>"
    Skjell $alias="Sk"
  "Fibrig torv. Fibrig struktur, lett gjenkjennelig plantestruktur, viser noe styrke,<engelsk> Fibrous peat</engelsk>"
    FibrigTorv $alias="Tl"
  "Delvis fibrig torv. Gjenkjennelig plantestruktur, ingen styrke i planterestene<engelsk>Pseudo-fibrous peat</engelsk>"
    DelvisFibrigTorv $alias="Tm"
  "Stein<engelsk>Cobbles</engelsk>\r\nstein (fraksjoner mellom 63 og 200 mm)<engelsk>cobbles (fractions between 63 and 200 mm</engelsk>"
    Stein $alias="St"
  "Berg eller blokk<engelsk>Rock or boulders</engelsk>"
    BergEllerBlokk $alias="BelBl"
}

"proporsjonalitetskonstant som relaterer vannstrømningsrate gjennom et medium til gradienten\r\n\r\nMerknad: Kalles også hydraulisk ledningsevne og avhenger av både vannets og mediets egenskaper.\r\n\r\n<engelsk>proportionality constant which relates water permeability through a medium with the gradient</engelsk>"
  codelist HydrauliskKonduktivitet {
  "dårlig vanngiver  <engelsk>poor water source</engelsk>"
    Dårlig_vanngiver
  "ganske dårlig vanngiver <engelsk>pretty poor water source</engelsk>"
    Ganske_dårlig_vanngiver
  "god vanngiver <engelsk>good water source</engelsk>"
    God_vanngiver
  "meget dårlig vanngiver <engelsk>very poor water source</engelsk>"
    Meget_dårlig_vanngiver
  "meget god vanngiver <engelsk>very good water source</engelsk>"
    Meget_god_vanngiver
}

"oversikt over klassifiseringsmetoder for bestemmelse av grunnforhold<engelsk>overview of classification methods for determination of ground conditions</engelsk>"
  codelist KlassifiseringsMetode $alias="ClassificationMethod" {
  "tolket fra observasjon<engelsk>interpreted from observation</engelsk>"
    Observasjon
  "tolket fra sondering i felt<engelsk>interpreted from sounding in the field</engelsk>"
    TolketFeltsondering
  "tolket fra boring i berg<engelsk>interpreted from drilling in rock</engelsk>"
    TolketBergBoring
  "tolket fra boring 3 m inn i berg<engelsk>interpreted from boring 3 m into rock</engelsk>"
    TolketBergBoring3Meter
  "tolket fra prøving i laboratoriet<engelsk>interpreted from testing in the laboratory</engelsk>"
    TolketLab
  "tolket fra tegning<engelsk>interpreted from drawing</engelsk>"
    TolketTegning
  "uspesifisert tolkningskilde<engelsk>unspecified source of interpretation</engelsk>"
    Uspesifisert
  "beregnet størrelse fra terrengoverflaten<engelsk>calculated from the terrain surface</engelsk>"
    BeregnetFraTerrengoverflaten
  "tolket fra prøvetaking i felt<engelsk>interpreted from sampling in the field</engelsk>"
    TolketPrøvetak
}

"beskriver om borlengde til berg er antatt eller påvist med en sikker metode\r\n\r\n<engelsk> \r\ndefines the quality of the depth information either assumed or confirmed by a secure method\r\n</engelsk>"
  codelist KvalitetBorlengdeTilBerg $alias="QualityBoreholeLenghtToRock" {
  "usikker angivelse av dybde til berg\r\n\r\n<engelsk> \r\nuncertain depth to rock\r\n</engelsk>"
    antatt
  "sikker angivelse av dybde til berg\r\n\r\n<engelsk> \r\nconfirmed depth to rock\r\n</engelsk>"
    påvist
}

"Koder for grad av sikkerhet for påvisning av kvikkleire eller sprøbruddmateriale"
  codelist KvikkleirePåvisningKode {
  "Benyttes ved sondering"
    Antatt
  IkkeVurdert
  "Kan kun benyttes der kvikkleire eller sprøbruddmateriale er påvist ved prøvetaking"
    Sikker
  "Benyttes ved sondering"
    Usikker
  "Benyttes ved sondering"
