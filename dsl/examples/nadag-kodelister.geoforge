package no.ngu.nadag.kodelister

"oversikt over mulige akvifertyper for grunnvannsmålinger<engelsk>overview of possible aquifer types for ground water measurements</engelsk>"
  codelist AkviferType {
  "grunnvannsmagasin med artesisk trykk (poreovertrykk)<engelsk>aquifer with artesian pressure (excess pore pressure)</engelsk>"
    Artesisk
  "lukket (avskjermet) grunnvannsmagasin<engelsk>closed (protected) aquifer</engelsk>"
    Lukket
  "utett (drenert) grunnvannsmagasin<engelsk>drained aquifer</engelsk>"
    Utett
  "åpent grunnvannsmagasin<engelsk>open aquifer</engelsk>"
    Åpen
  "informasjon mangler <engelsk>not specified</engelsk>"
    Ikke_angitt
}

"Kodeliste for å angi deformasjonsobservasjon"
  codelist DeformasjonObservasjonKode {
  IkkeSpesifisert
  Hindring
  Skadet
  Usikkert
}

"Kodeliste for feltundersøkelsestype"
  codelist FeltUndersTypeKode {
  FeltUndersMetode
  TolketBerghøyde
  Tolket
}

"oversikt over koder for observasjoner som gjøres ved utførelse av en grunnundersøkelse. Benyttes i egenskapen «observasjonKode» som i mai 2024 ble gjort om til tekststreng fra å være knyttet til denne kodelisten. Tekstrengen kan inneholde mer enn 1 kode. <engelsk>overview of codes for observations conducted during an GeotechnicalBoreholeInvestigation. Used in the \"observasjonKode\" attribute, which in May 2024 was changed to a text string from being linked to this code list. The text string can contain more than 1 code. </engelsk>"
  codelist GeotekniskBoreObservasjonskode {
  "kode for påvisning av grunnvannstand\r\n<engelsk>code for detection of the ground water table\r\n</engelsk>"
    AntattGrunnvann
  "kode for avslutning av boring\r\n<engelsk>code for termination of boring</engelsk>"
    Avsluttet
  "kode for avslutning av boring i blokk\r\n<engelsk>code for termination of boring in blocks</engelsk>"
    BlokkSlutt
  "kode for bøyd sonderingsstang\r\n<engelsk>code for curved sounding rods</engelsk>"
    BøydSonderingsstang
  "kode for avslutning av boring i berg med slag\r\n<engelsk>code for termination of boring in rock with strokes</engelsk>"
    FjellMedSlag
  "kode for angivelse av dybde for bergoverflate\r\n<engelsk>code for identification of depth to the rock surface</engelsk>"
    Fjellnivå
  "kode for markering av feil i forrige angitte kode<engelsk>code for marking errors in previously given code</engelsk>"
    ForrigeKodeFeil
  "kode for boring i friksjonsjord<engelsk>code for boring in friction soils</engelsk>"
    Friksjonsjord
  "kode for boring i frosset materiale<engelsk>code for boring in frozen soils</engelsk>"
    Frosset
  "kode for angivelse av boring i frostisoleringsmateriale<engelsk>code for boring in frost-insulation materials</engelsk>"
    Frostisolering
  "kode for markering av ikke-godkjent funksjon<engelsk>code for marking of non-approved function</engelsk>"
    FunksjonskontrollIkkeOk
  "kode for markering av godkjent funksjon<engelsk>code for marking of approved function</engelsk>"
    FunksjonskontrollOk
  "kode for boring i fylling<engelsk>code for boring in fills and embankments</engelsk>"
    Fylling
  "kode for gjennomboring av blokk eller stein<engelsk>code for penetration of block or stone</engelsk>"
    GjennomborretBlokkEllerStein
  "kode for angivelse av hindring<engelsk>code for information of hindrances</engelsk>"
    Hindring
  "kode for boring gjennom ikke-merkbare sprekker<engelsk>code for boring through non-recordable cracks and fissures</engelsk>"
    IkkeMerkbareSprekker
  "kode for markering av manglende registrering <engelsk>code for marking of lacking registration</engelsk>"
    IngenRegistrering
  "kode for markering av manglende vurdering<engelsk>code for marking of lacking evaluation</engelsk>"
    IngenVurdering
  "kode for boring gjennom jord med grus<engelsk>code for boring through soil with gravel</engelsk>"
    JordMedGrus
  "kode for boring gjennom jord med sand<engelsk>code for boring through soil with sand</engelsk>"
    JordMedSand
  "kode for boring gjennom jord med stein<engelsk>code for boring through soil with stones</engelsk>"
    JordMedStein
  "kode for boring gjennom jord med kull og aske<engelsk>code for boring through soil with coal and ashes</engelsk>"
    KullAske
  "kode for boring gjennom leire<engelsk>code for boring through clay</engelsk>"
    Leire
  "kode for boring gjennom finstoffholdig morene<engelsk>code for boring through clayey moraine and till</engelsk>"
    LeirMorene
  "kode for markering av tilleggsinformasjon<engelsk>code for marking of additional information</engelsk>"
    MerInformasjon
  "kode for boring gjennom morenejord<engelsk>code for boring through morainic soil</engelsk>"
    MoreneJord
  "kode for markering av overgang til ny metode<engelsk>code for marking of transition to new method</engelsk>"
    NyMetode
  "kode for markering av opphold i boringen<engelsk>code for marking of halt in the boring</engelsk>"
    Opphold
  "kode for boring gjennom oppsprukket berg<engelsk>code for boring through cracked rock</engelsk>"
    OppsprukketFjell
  "kode for boring gjennom organisk materiale<engelsk>code for boring through organic materials</engelsk>"
    OrganiskJord
  "kode for markering av pumping med borstengene (repetert vertikal opptrekking og nedpressing av stangsystemet)<engelsk>code for marking of pumping wth drill rods (repeated sequences of vertical hoisting and pushing of the rod system)</engelsk>"
    Pumping
  "kode for avslutning av pumping<engelsk>code for termination of pumping</engelsk>"
    PumpingSlutt
  "kode for boring gjennom sand med grus<engelsk>code for boring through soil with sand and gravel</engelsk>"
    SandmedGrus
  "kode for boring gjennom silt<engelsk>code for boring through silt</engelsk>"
    Silt
  "kode for markering av skade på borutstyr<engelsk>code for marking of damage of drilling equipment</engelsk>"
    Skadet
  "kode for markering av stangskjøting (svensk terminologi)<engelsk>code for marking of added rods (swedish terminology)</engelsk>"
    Skarv
  "kode for markering av slag på borstenger<engelsk>code for marking of strokes on drill rods</engelsk>"
    Slag
  "kode for markering av slag på borstenger og spyling gjennom borkrone<engelsk>code for marking of strokes on the drill rods and/or flushing through the drill bit</engelsk>"
    SlagSpyl
  "kode for markering av avslutning av slag på borstenger og spyling gjennom borkrone<engelsk>code for marking of termination of strokes on the drill rods and/or flushing through the drill bit</engelsk>"
    SlagSpylSlutt
  "kode for markering av avslutning av slag på borstenger<engelsk>code for marking of termination of strokes on the drill rods</engelsk>"
    SluttSlag
  "kode for avslutning av vridning av borstenger<engelsk>code for termination of rotation of the drill rods</engelsk>"
    SluttVridning
  "kode for demontering av borstang<engelsk>code for demounting of a drill rod</engelsk>"
    SonderingstangAv
  "kode for angivelse av dybde for borspiss<engelsk>code for identification of depth for the drill bit</engelsk>"
    SpissDyp
  "kode for markering av spyling gjennom borkrone<engelsk>code for marking of flushing through the drill bit</engelsk>"
    Spyling
  "kode for avslutning av spyling gjennom borkrone<engelsk>code for termination of flushing through the drill bit</engelsk>"
    SpylingSlutt
  "kode for angivelse av startnivå<engelsk>code for given start level</engelsk>"
    Startnivå
  "kode for start av slag på borstenger<engelsk>code for start of strokes on the drill rods</engelsk>"
    StartSlag
  "kode for start av vridning på borstenger<engelsk>code for start of rotation of the drill rods</engelsk>"
    StartVridning
  "kode for boring gjennom svært oppsprukket berg<engelsk>code for boring through very cracked rock</engelsk>"
    SværtOppsprukketFjell
  "code for angivelse av synk for 0 vekt (dreiesondering)<engelsk>code for given sink of drill rods for 0 load (rotary weight sounding)</engelsk>"
    SynkVekt0
  "kode for angivelse av synk for 0.64 vekt (dreiesondering) <engelsk>code for given sink of drill rods for 0.64 load (rotary weight sounding)</engelsk>"
    SynkVekt0_64
  "kode for markering av terrengoverflate <engelsk>code for marking of the terrain surface</engelsk>"
    Terrengoverflate
  "kode for markering av tidligere stopp i boringen <engelsk>code for marking of previous stops in the boring</engelsk>"
    TidligereStopp
  "kode for angivelse av tid <engelsk>code for time</engelsk>"
    Tidsangivelse
  "code for boring gjennom torv\r\n<engelsk>code for boring through peat</engelsk>"
    Torv
  "kode for boring gjennom tørrskorpe\r\n<engelsk>code for boring through dry crust</engelsk>"
    Tørrskorpe
  "kode for boring gjennom ubestemt jordart <engelsk>code for boring through undetermined soil</engelsk>"
    UbestemtJordart
  "kode for boring gjennom uorganisk kohesjonsjord\r\n<engelsk>code for boring through inorganic cohesive soil</engelsk>"
    UorganiskKohesjonsjord
  "kode for boring gjennom inhomogen makadam (pukk) <engelsk>code for boring through inhomogenous macadam (blasted rock)</engelsk>"
    UrenMakadam
  "kode for boring uten vridning (rotasjon) av borstenger<engelsk>code for boring without rotation of the drill rods</engelsk>"
    UtenVridning
  "kode for boring med vridning (rotasjon) av borstenger<engelsk>code for boring with rotation of the drill rods</engelsk>"
    Vridning
}

"Koder for metoder benyttet ved geotekniske feltundersøkelser"
  codelist GeotekniskFeltUndersMetodeKode {
  Ramsondering
  BelastningTest
  SetningMåling
  Skrueplate
  SPT
  PermeabilitetMåling
  ElektriskSondering
  HelningMåling
  Skovlboring
}

"oversikt over observasjonskoder for grunnvann"
  codelist GeotekniskGrunnvannObservasjonKode $alias="GroundwaterObservationCode" {
  IkkeSpesifisert
  Tørr
  Vannstrøm
  Erstattet
  Ferdig
  Stikk
  FunksjonSjekkOk
  FunksjonSjekkFeilet
  Spylet
  Frosset
}

