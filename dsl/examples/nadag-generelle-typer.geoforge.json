    {
      "elementType": "dataType",
      "name": [
        "no",
        "ngu",
        "nadag",
        "generelle_typer",
        "Identifikasjon"
      ],
      "description": "Unik identifikasjon av et objekt, ivaretatt av den ansvarlige produsent/forvalter, som kan benyttes av eksterne applikasjoner som referanse til objektet. \r\n\r\nNOTE1 Denne eksterne objektidentifikasjonen må ikke forveksles med en tematisk objektidentifikasjon, slik som f.eks bygningsnummer. \r\n\r\nNOTE 2 Denne unike identifikatoren vil ikke endres i løpet av objektets levetid.",
      "tags": [
        {
          "name": "alias",
          "value": "Identification"
        }
      ],
      "abstract": false,
      "properties": [
        {
          "elementType": "compositeTypeProperty",
          "name": [
            "lokalId"
          ],
          "description": "lokal identifikator, tildelt av dataleverendør/dataforvalter. Den lokale identifikatoren er unik innenfor navnerommet, ingen andre objekter har samme identifikator.\r\n\r\nNOTE: Det er data leverendørens ansvar å sørge for at denne lokale identifikatoren er unik innenfor navnerommet.",
          "tags": [
            {
              "name": "alias",
              "value": "localId"
            }
          ],
          "kind": "id",
          "type": {
            "qName": [
              "geoforge",
              "lib",
              "CharacterString"
            ],
            "sourceFile": "nadag-builtins.geoforge"
          },
          "multiplicity": {
            "lower": 1,
            "upper": 1
          }
        },
        {
          "elementType": "compositeTypeProperty",
          "name": [
            "navnerom"
          ],
          "description": "navnerom som unikt identifiserer datakilden til objektet, starter med to bokstavs kode jfr ISO 3166. Benytter understreking  (\"_\") dersom data produsenten ikke er assosiert med bare et land.\r\n\r\nNOTE 1 : Verdien for nanverom vil eies av den dataprodusent som har ansvar for de unike identifikatorene og vil registreres i \"INSPIRE external  Object Identifier Namespaces Register\"\r\n\r\nEksempel: NO for Norge.",
          "tags": [
            {
              "name": "alias",
              "value": "namespace"
            }
          ],
          "type": {
            "qName": [
              "geoforge",
              "lib",
              "CharacterString"
            ],
            "sourceFile": "nadag-builtins.geoforge"
          },
          "multiplicity": {
            "lower": 1,
            "upper": 1
          }
        },
        {
          "elementType": "compositeTypeProperty",
          "name": [
            "versjonId"
          ],
          "description": "identifikasjon av en spesiell versjon av et geografisk objekt (instans), maksimum lengde på 25 karakterers. Dersom spesifikasjonen av et geografisk objekt med en identifikasjon inkludererer livsløpssyklusinformasjon, benyttes denne versjonId for å skille mellom ulike versjoner av samme objekt. versjonId er en unik  identifikasjon av versjonen. \r\n\r\nNOTE Maksimum lengde er valgt for å tillate tidsregistrering i henhold til  ISO 8601, slik som  \"2007-02-12T12:12:12+05:30\" som versjonId.",
          "tags": [
            {
              "name": "alias",
              "value": "versionId"
            }
          ],
          "type": {
            "qName": [
              "geoforge",
              "lib",
              "CharacterString"
            ],
            "sourceFile": "nadag-builtins.geoforge"
          },
          "multiplicity": {
            "lower": 0,
            "upper": 1
          }
        }
      ]
    },
