    vannstandIBorehull?: Real $alias="waterLevelBoreHole"
  "diameter for vingekors [mm] <engelsk>diameter of the vane<engelsk>"
    vingeDiameter?: Real $alias="vaneDiameter"
  "høyde for vingekors [mm] <engelsk>height of the vane</engelsk>"
    vingeHøyde?: Real $alias="vaneHight"
  "identifikasjon for anvendt vingeborutstyr<engelsk>identification of applied vane test equipment</engelsk>"
    vingeIdentitet?: CharacterString $alias="vaneIdentity"
  vingeboringObservasjon*: VingeboringData
