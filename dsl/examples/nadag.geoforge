model no.ngu.nadag

import geoforge.lib
import no.ngu.nadag.datatyper
import no.ngu.nadag.abstrakte_featurtyper
import no.ngu.nadag.generelle_typer
import no.ngu.nadag.kodelister

"fysisk prøvemateriale manuelt skjært ut fra bunnen av en utgravning eller ved hjelp av spesialutviklet prøvetakingsutstyr\r\n\r\n<engelsk>physical sample manually cut from the bottom of a ditch or with special sample equipment</engelsk>"
  feature BlokkPrøve $alias="BlockSample" extends GeotekniskPrøvetaking {
}

"undersøkelse for måling av setninger og deformasjoner i felt<engelsk>investigation for measurement of settlements and deformations in the field</engelsk>"
  feature DeformasjonMåling $alias="DeformationMeasurement" extends GeotekniskObservasjon {
  "verdi for målt bevegelse, uten angitt forteg<engelsk>value for measured deformation, without sign</engelsk>"
    absoluttverdi?: Boolean $alias="absolutValues"
  "tidspunktet måleren ble installert<engelsk>time of installation for the settlement gauge</engelsk>"
    installasjonTidspunkt?: DateTime
  "dybdemåleren er installert i og det punkt der setningen måles (z-nivå installasjon) [m] <engelsk>depth of the settlement gauge where settlements are recorded (z-level installation)</engelsk>"
    installasjonNivå?: Real
  "type setningsmåler (setningsplate, setningsbolt, slange)<engelsk>type of settlement gauge (settlement plate, bolt, settlement hose)</engelsk>"
    målertype?: CharacterString
  "registrering av referansepunkt for setningsmåling (z-nivå måling). Kan avvike fra installasjonsnivå [m] <engelsk>recording of reference level for settlements (z-level measurements). My deviate from installation level</engelsk>"
    målepunkt?: Real $alias="measuringPoint"
  harOvervåkningObservasjon*: DeformasjonOvervåkningData
  harSetningObservasjon*: DeformasjonMåleData
}

"en enkel innretning, formet som et flatt blad designet for å trykkes ned i bakken. Merknad: ble utviklet for å bestemme modulus for en jordart.\r\n<engelsk>a simple device, shaped in the form of a flat blade designed to be pushed into the ground Note: It was developed to evaluate the soil modulus.</engelsk>"
  feature DilatometerTest $alias="DilatometerTest" extends GeotekniskInsituTest {
  "materialindeks<engelsk>material index</engelsk>"
    materialIndeks?: Real
  "horisontalspenning index<engelsk>horizontal stress index</engelsk>"
    horisontalSpenningIndeks?: Real
  "dilatometer modulus (enhetsløs) <engelsk>dilatometer modulus</engelsk>"
    dilatometerModulus?: Real
  dilatometerObservasjon*: DilatometerTestData
}

"sondering som benytter slag på borstrengen ved penetrasjon, benevnes også som ramsondering, flere liknende metoder aktuelle<engelsk>sounding using strokes on the drill string during penetration, several similar methods are applicable</engelsk>"
  feature DynamiskSondering $alias="DynamicSounding" extends GeotekniskSondering {
  "antall prøver av fysisk prøvemateriale som er tatt opp under sonderingen<engelsk>number of samples retrieved during sounding</engelsk>"
    antPrøveuttakForstyrretMatr?: Integer
  dynamiskSonderingObservasjon*: DynamiskSonderingData
}

"måling av  gass<engelsk>measurement of gas</engelsk>"
  feature GassMåling $alias="GasMeasurement" extends GeotekniskInsituTest {
  "beskrivelse av plassering<engelsk>description of location</engelsk>"
    plassering?: CharacterString
  "nummer som identifiserer bygg<engelsk>number that identifies building</engelsk>"
    byggNummer?: CharacterString
  gassObservasjon*: GassData
}

"gassprøve fra poreluft<engelsk>gas sample from pore air</engelsk>"
  feature GassPrøve $alias="GasSample" extends GeotekniskPrøvetaking {
}

"geografisk område representert ved et punkt som er den logiske enhet for tolking av laginndeling og egenskaper til de forskjellige jordlag <engelsk>geographical area represented by a location which is the logical unit for interpretation of stratification and properties for the different strata </engelsk>"
  feature GeotekniskBorehull $alias="GeotechnicalBorehole" extends GeovitenskapligBorehull {
  "Nummer på borehull benyttet i den geotekniske undersøkelsen"
    boreNr?: CharacterString $alias="boreholeNr"
  "Terrenghøyde ved start borehull [m]"
    høyde?: Real
  "Referansesystem for høydeangivelse, som EPSG-kode."
    høydeReferanse?: NADAG_Høyderef
  "Når objektet ble opprettet i database (Nadag)"
    opprettetDato: DateTime $alias="entryDate"
  "Identifikasjon av et objekt, ivaretatt av den ansvarlige leverandør, som kan benyttes av eksterne applikasjoner som referanse til objektet."
    eksternIdentifikasjon?: EksternIdentifikasjon
  "Grad av sikkerhet for påvisning av kvikkleire (omrørt skjærfasthet mindre eller lik 0,5 kPa) eller sprøbruddmateriale (omrørt skjærfasthet mindre enn 2 kPa)"
    kvikkleirePåvisning?: KvikkleirePåvisningKode
  "opprinneligGeotekniskUndersID - LokalID fra opprinnelig Geoteknisk undersøkelse. \r\nBenyttes for å identifisere orginal undersøkelse med rapporter etc. ved bruk av samme GeotekniskBorehull i flere undersøkelser."
    opprinneligGeotekniskUndersID?: CharacterString $alias="originalGeotechnicalInvestigationID"
  "referanse til opphavsmaterialet, kildematerialet, organisasjons/publiseringskilde"
    opphav?: CharacterString
  "Lengste boret lengde for borehullsundersøkelsene i dette borhullet [m]"
    maksBoretLengde?: Real
  child harUndersøkelse*: GeotekniskBorehullUnders
  parent undersOmr*: GeotekniskUnders
}

"geografisk punkt hvor det er utført feltforsøk, prøvetaking, måling av poretrykk osv. med tilhørende observasjoner <engelsk>geographical location where field tests, sampling, pore pressure measurements etc. with corresponding observations have been carried out</engelsk>"
  feature GeotekniskBorehullUnders $alias="GeotechnicalBoreholeInvestigation" extends GeovitenskapligBorehullUndersøkelse {
  "Terrenghøyde ved start borehullsundersøkelse [m]"
    høyde?: Real
  "Referansesystem for høydeangivelse, som EPSG-kode."
    høydeReferanse?: NADAG_Høyderef
  "Nummer på borehullundersøkelse benyttet i den geotekniske undersøkelsen"
    undersøkelseNr?: CharacterString $alias="surveyNo"
  "Identifikasjon av et objekt, ivaretatt av den ansvarlige leverandør, som kan benyttes av eksterne applikasjoner som referanse til objektet."
    eksternIdentifikasjon?: EksternIdentifikasjon
  "Når objektet ble opprettet i database (Nadag)"
    opprettetDato: DateTime
  "Metoder benyttet ved geotekniske borehullundersøkelser"
    geotekniskMetode: GeotekniskMetodeKode
  "dybde [m] fra terrengoverflaten til det nivå i grunnen der alle porene i jorden er mettet med vann og poretrykket begynner å stige <engelsk>depth [m] from the terrain surface to the level in the ground where all voids are saturated with water, and where the pore pressure starts to increase</engelsk>"
    dybdeGrunnvannstand?: Real $alias="groundWaterDept, groundWaterLevel"
  "diameter [mm] av forboret hull i en borhullundersøkelse <engelsk>diameter (mm) of a predrilled hole in a borehole investigation</engelsk>"
    forboretDiameter?: Real $alias="preBoringDiameter"
  "Lengde[m] av forboret hull i en borhullundersøkelse <engelsk>Length[m] of a predrilled borehole in a borehole investigation<engelsk>"
    forboretLengde?: Real $alias="preBoringLength"
  "metode brukt til boring uten registrering av data<engelsk>pre boring method</engelsk>"
    forboringMetode?: CharacterString $alias="preBoringmethod"
  "tosifret tall som benyttes for å angi årsak til avslutning av borehullundersøkelse<engelsk>code used to explain the reason for termination of a borehole investigation<engelsk>"
    stoppKode?: GeotekniskStoppkode $alias="terminationCode"
  "startlengde[m] for hvor forboring startet i en borhullundersøkelse <engelsk>start depth[m] where the predrilling in the  borehole investigation started<engelsk>"
    forboretStartLengde?: Real $alias="preBoringStartLength"
  child metode*: Geotekniskmetode
  parent undersPkt?: GeotekniskBorehull
}

"dokument(er) tilhørende geotekniske undersøkelsesområder og borehull <engelsk>accompanying documents to geotechnical investigation areas and boreholes</engelsk>"
  feature GeotekniskDokument {
  "Unik nøkkel for dokument."
    dokumentID?: CharacterString
  "Benyttes til å angi nøkkelverdi ved kall til Web-api."
    dokumentNøkkel?: CharacterString
  "Type dokument. Feks. Geoteknisk rapport, Profilbilde"
    dokumentType: NADAG_DokumentType
  "Filnavn på dokumentet."
    dokumentFilnavn?: CharacterString
  "Komplett URL for dokument med id."
    dokumentURL?: CharacterString
  "Type dokumentformat, feks. Image/png, pdf"
    innholdType?: CharacterString
  "Kort informasjon om dokumentet"
    beskrivelse?: CharacterString
  "Identifikasjon av et objekt, ivaretatt av den ansvarlige leverandør, som kan benyttes av eksterne applikasjoner som referanse til objektet."
    eksternIdentifikasjon?: EksternIdentifikasjon
  "Navn på dokument"
    dokumentNavn?: CharacterString
  "Når objektet ble opprettet i database (Nadag)"
    opprettetDato?: DateTime $alias="entryDate"
  "Feks. rapportNr."
    dokumentNr?: CharacterString
  "Dato når dokument ble opprettet"
    dokumentDato?: DateTime $alias="dokumentDato"
  parent tilhørerFeltUnders?: GeotekniskFeltUnders
  parent tilhørerGU?: GeotekniskUnders
  parent tilhørerGB?: GeotekniskBorehull
  parent tilhørerGBU?: GeotekniskBorehullUnders
}

"Geoteknisk feltundersøkelse"
  feature GeotekniskFeltUnders {
  "unik identifikasjon av et objekt"
    identifikasjon: Identifikasjon
  "sted objektet eksisterer på bestemt av måleutstyr"
    geometry posisjon: Punkt
  "Metoder benyttet ved geotekniske feltundersøkelser"
    geotekniskFeltUndersMetode?: GeotekniskFeltUndersMetodeKode
  "Identifikasjon av et objekt, ivaretatt av den ansvarlige leverandør, som kan benyttes av eksterne applikasjoner som referanse til objektet."
    eksternidentifikasjon?: EksternIdentifikasjon
  "Når objektet ble opprettet i database (Nadag)"
    opprettetDato?: DateTime $alias="entryDate"
  feltundersType?: FeltUndersTypeKode
  "Metoder benyttet for tolkning av geotekniske feltundersøkelser"
    tolkningMetode?: TolkningMetodeKode
  "Høyde på observert fjell [m]"
    høydeFjell?: Real
  "Terrenghøyde ved start feltundersøkelse [m]"
    høyde?: Real
  "Referansesystem for høydeangivelse, som EPSG-kode."
    høydeReferanse?: NADAG_Høyderef
  "Nummer på feltundersøkelse benyttet i den geotekniske undersøkelsen"
    feltundersNr?: CharacterString
  parent tilhørerGU?: GeotekniskUnders
}

"Undersøkelse gjort i et borehull i form av en prøveserie<engelsk> Soil     test </engelsk>"
  feature GeotekniskPrøveserie $alias="SoilTest" extends GeotekniskPrøvetaking {
  "om det er benyttet prøvegrop<engelsk> indicating whether a soil test has a bag sample</engelsk>"
    prøvegrop?: Boolean $alias="hasPgData"
  "om det kun er benyttet prøvegrop<engelsk>indicating whether a soil test has only a bag sample</engelsk>"
    prøvegropKun?: Boolean $alias="hasPgDataOnly"
  "om det er benyttet skovlprøve<engelsk>indicating whether a soil test has grab (Skv) sample</engelsk>"
    skovelprøve?: Boolean $alias="hasSkvData"
  "om det kun er benyttet skovlprøve<engelsk> indicating whether a soil test has only a grab (Skv) sample</engelsk>"
    skovelprøveKun?: Boolean $alias="hasSkvDataOnly"
  "om prøvserien er omrørt<engelsk>indicating whether a soil test is disturbed</engelsk>"
    erOmrørt?: Boolean $alias="isDisturbed"
  "om prøvserien er uforstyrret<engelsk>indicating whether a soil test is undisturbed</engelsk>"
    erUforstyrret?: Boolean $alias="isUndisturbed"
}

"Lag med geoteknisk tolkning"
  feature GeotekniskTolketLag {
  "Unik nøkkel for tolktet lag"
    tolketLagID?: CharacterString
  "oversikt over klassifiseringsmetoder for bestemmelse av grunnforhold"
    klassifiseringMetode?: KlassifiseringsMetode
  "oversikt over lagdeling og jordart for klassifisering og identifisering av grunnforhold"
    hovedLagKlassifiseringsKode?: HovedLagKlassifisering
  "Beskrivelse av tolket lag feks. Sand"
    lagBeskrivelse?: CharacterString
  "Hvem som har gjort tolkning"
    tolketAv?: CharacterString
  "Når tolkning ble utført"
    tolketTidspunkt?: DateTime
  "Kommentar til tolkning"
    tolkningMerknad?: CharacterString
  "Navn på tolket lag"
    navn?: CharacterString
  "Om tolkning er på terrengoverflate"
    påTerrengOverflate?: Boolean
  "Hvor sikker tolkning er, med  0=Udefinert,5=Sikker og glidende skala imellom."
    vurdering?: Real
  "Om tolkning er under terrengoverflate"
    underTerrengOverflate?: Boolean
  "Identifikasjon av et objekt, ivaretatt av den ansvarlige leverandør, som kan benyttes av eksterne applikasjoner som referanse til objektet."
    eksternIdentifikasjon?: EksternIdentifikasjon
  "objektets utstrekning gitt i x.y,z."
    geometry posisjon: Punkt
  "Laghøyde for tolkning [m]"
    høyde?: Real
  "referansesystem for høydeangivelse, som EPSG-kode."
    høydeReferanse?: NADAG_Høyderef
  parent tilhørerTolketPunkt?: GeotekniskTolketPunkt
}

"Punkt med geoteknisk tolkning i GeotekniskTolketLag"
  feature GeotekniskTolketPunkt {
  "unik identifikasjon av et objekt"
    identifikasjon: Identifikasjon
  "Hvem som har tolket punktet"
    tolketAv?: CharacterString
  "Når tolkning ble utført"
    tolketTidspunkt?: DateTime
  "Navn på tolket punkt"
    navn?: CharacterString
  "objektets utstrekning gitt i x.y,z."
    geometry posisjon: Punkt
  "Terrenghøyde overflate for punkt med tolkning(/er)[m]"
    høyde: Real
  "Referansesystem for høydeangivelse, som EPSG-kode."
    høydeReferanse: NADAG_Høyderef
  "kartmålestokk registreringene/ datene er hentet fra/ registrert på\r\n\r\nEksempel: 1:50 000 = 50000."
    digitaliseringsmålestokk?: Integer
  "beskrivelse av kvaliteten på stedfestingen"
    kvalitet?: PosisjonskvalitetNADAG
  "dato for siste endring på objektetdataene \r\n\r\nMerknad: \r\nOppdateringsdato kan være forskjellig fra Datafangsdato ved at data som er registrert kan bufres en kortere eller lengre periode før disse legges inn i datasystemet (databasen).\r\n\r\n-Definition-\r\nDate and time at which this version of the spatial object was inserted or changed in the spatial data set."
    oppdateringsdato?: DateTime
  "kort tilleggsinformasjon om punktet for tolkning/er \r\n<engelsk>\r\na short description</engelsk>"
    beskrivelse?: CharacterString
  parent tilhørerGU?: GeotekniskUnders
  parent tilhørerGB?: GeotekniskBorehull
}

"geografisk område hvor det finnes eller er planlagt geotekniske borehull tilhørende et gitt prosjekt <engelsk>geographical area where there are or are planned geotechnical boreholes for a given project</engelsk>"
  feature GeotekniskUnders $alias="GeotechnicalInvestigation" extends GeovitenskapeligUndersøkelse {
  "Identifikasjon av et objekt, ivaretatt av den ansvarlige leverandør, som kan benyttes av eksterne applikasjoner som referanse til objektet."
    eksternIdentifikasjon?: EksternIdentifikasjon
  "Angir hva avgrensningen/polygonen for en geoteknisk undersøkelse fysisk representerer."
    representasjonKvalitet?: RepresentasjonKvalitet
  "Når objektet ble opprettet i database (Nadag)"
    opprettetDato: DateTime $alias="entryDate"
  "Nummer på prosjekt benyttet for den geotekniske undersøkelsen"
    prosjektNr?: CharacterString
  "referanse til opphavsmaterialet, kildematerialet, organisasjons/publiseringskilde"
    opphav?: CharacterString
  "Antatt år for gjennomføring av den geotekniske undersøkelsen. For største delen av de leverte dataene har det vært dårlig infomasjon i egenskapene for undersøkelseperiode og derfor utvides det med denne egenskapen. Årstallet her er hentet fra ulike kilder i leveransene og avhengig av hva for leveranser det er varierer usikkerheten på på det antatte årstallet."
    undersøkelseÅrAntatt?: Integer
  child undersPkt*: GeotekniskBorehull
}

"avgrensning av et område for geotekniske undersøkelser. Merk: Benyttes kun for de formater som krever egen geometri for avgrensning av flate. <engelsk>demarcation of an area with soil investigations. Only used for delivery formats that requier it.</engelsk>"
  feature GeotekniskUndersøkelseGrense $alias="GeotechnicalInvestigationBorder" extends GeovitenskapeligUndersøkelseGrense {
}

"omrørt fysisk prøvemateriale manuelt gravd ut fra sjakt eller grøft <engelsk>disturbed physical soil sample manually digged from a ditch or pit</engelsk>"
  feature GravePrøve $alias="DigSample" extends GeotekniskPrøvetaking {
}

"måling av grunnvannstand i felt<engelsk>measurement of the ground water table in the field</engelsk>"
  feature GrunnvannMåling $alias="GroundWaterMeasurement" extends GeotekniskInsituTest {
  "indikerer varighet av måleperiode ved langtidsmåling\r\n<engelsk>indicates duration of the test period in long-term measurements</engelsk>"
    erLangtidsobservasjon: Boolean $alias="isLongTimeObservation"
  "dybde til midten av filteret i forhold til rørTopp [m]\r\n<engelsk> depth to center of filter in relation to height at top of pipe [m] </engelsk>"
    filterDyp?: Real $alias="filterLength"
  "lengde av filter i målerør [m] <engelsk>length of the filter in measurement tube</engelsk>"
    filterLengde?: Real $alias="filterLength"
  "type filter i målerør<engelsk>type of filter in measurement tube</engelsk>"
    filterType?: CharacterString $alias="filterType"
  "type og størrelse av grunnvannsreservoir<engelsk>\r\ntype and size of groundwater reservoir</engelsk>"
    grunnvannAkvifer?: AkviferType $alias="groundWaterAquifer"
  "nivå (høyde) for bunn av målerør [m] <engelsk>level (height) for the base of the measurement tube</engelsk>"
    rørBunn?: Real $alias="bottomOfTube"
  "nivå (høyde) for topp av målerør [m] <engelsk>level (height) for the top of the measurement tube</engelsk>"
    rørTopp?: Real $alias="topOfTube"
  "type målerør for utførelse av hydraulisk måling<engelsk>\r\ntype of measurement tube for performance of groundwater measurements</engelsk>"
    rørType?: CharacterString $alias="pipeType"
  grunnvannObservasjon*: GrunnvannData
  overvåkningObervasjon*: OvervåkningData
}

"måling av vannstrømning, vannhastighetsbestemmelse og hydraulisk splitting i felt <engelsk>measurement of hydraulic tests (i.e. water flow, pulse tests and hydraulic fracturing tests) in the field</engelsk>"
  feature HydrauliskTest $alias="HydraulicTest" extends GeotekniskInsituTest {
  "nivå (høyde) for bunn av målerør [m] <engelsk>level (height) for the base of the measurement tube</engelsk>"
    rørBunn?: Real $alias="bottomOfTube"
  "nivå (høyde) for topp av målerør [m] <engelsk>level (height) for the top of the measurement tube</engelsk>"
    rørTopp?: Real $alias="topOfTube"
  "type målerør for utførelse av hydraulisk måling<engelsk>type of measurement tube for hydraulic measurements</engelsk>"
    rørType?: CharacterString $alias="pipeType"
  hydrauliskObservasjon*: HydrauliskeData
}

"omrørt fysisk prøvemateriale tatt i organiske materialer eller bløte leirer med enkelt håndoperert utstyr\r\n\r\n<engelsk>disturbed physical soil sample taken from organic material or soft clays with simple hand operated equipment</engelsk>"
  feature KannePrøve $alias="CanSample" extends GeotekniskPrøvetaking {
}

"kjerneprøve tatt i fast berg/fjell ved kjerneboring. Ofte dype boringer og normalt ikke relevant for geoteknikk. Tatt med i denne produktspesifikasjon pga. at data kan finnes sammen med geoteknikkleveranser. Blir eventuelt overført til annen database/produktspek senere. <engelsk>core drilling</engelsk>"
  feature KjerneBoring $alias="CoreDrilling" extends GeotekniskPrøvetaking {
  "dybde til bergoverflaten som ikke er målt men basert på tolkning<engelsk>depth to the rock surface based on interpretation and not measurements\r\n</engelsk>"
    boretLengdeTilBerg?: BorlengdeTilBerg
  harData*: KjerneBoringData
}

"kjerneprøve tatt i faste masser eller løst berg <engelsk>core sample</engelsk>"
  feature KjernePrøve $alias="CoreSample" extends GeotekniskPrøvetaking {
  "dybde til bergoverflaten som ikke er målt men basert på tolkning<engelsk>depth to the rock surface based on interpretation and not measurements\r\n</engelsk>"
    boretLengdeTilBerg?: BorlengdeTilBerg
}

"kombinasjon av boremetodene totalsondering og fjellkontrollboring som gjør det mulig å bore både i løsmasse og berg<engelsk>combination of the boring methods rotary pressure sounding and rock control boring which enables drilling in both soils and rock.</engelsk>"
  feature KombinasjonSondering $alias="CombinationSounding" extends GeotekniskSondering {
  "boret dybde til bergoverflaten [m] <engelsk>drilled depth to the rock surface</engelsk>"
    boretLengdeIBerg?: Real $alias="drillDepthRock"
  "dybde til bergoverflaten som ikke er målt men basert på tolkning [m] <engelsk>depth to the rock surface based on interpretation and not measurements</engelsk>"
    boretLengdeTilBerg?: BorlengdeTilBerg
  "maksimal nedpressingskraft registrert på overflaten [kN] <engelsk>maximum penetration force recorded on the surface</engelsk>"
    maksLast?: Real $alias="maxLoad"
  kombinasjonSonderingObservasjon*: KombinasjonSonderingData
}

"miljøundersøkelse<engelsk>environmental investigation</engelsk>"
  feature MiljøUndersøkelse $alias="EnvironmentalSample" extends GeotekniskPrøvetaking {
}

"geoteknisk prøvetaking for opptak av omrørte prøver <engelsk>geotechnical sampling where disturbed samples are colleced</engelsk>"
  feature NaverPrøve $alias="AugerSample" extends GeotekniskPrøvetaking {
}

"undersøkelse for måling av in situ deformasjons- og konsolideringsegenskaper i friksjonsjordarter<engelsk>investigation for measurement of in situ deformation- and consolidation properties in friction soils</engelsk>"
  feature Platebelastning $alias="Plate-bearing test" extends GeotekniskInsituTest {
  "antall belastningstrinn i en målesekvens<engelsk>number of load steps in a test sequence</engelsk>"
    lasttrinnAntall?: Integer
  "areal av skruplate for fordeling av tilleggslast [m2]<engelsk>area of screw plate for distribution of additional load</engelsk>"
    arealPlate?: Real
  platebelastningObservasjon*: PlatebelastningData
}

"måling av poretrykkforhold i grunnen foretatt i løpet av en tidsperiode og / eller i flere dybder. poretrykk er trykket i porevannet angitt som kraft pr. flateenhet, og med atmosfæretrykket som referanse<engelsk>measurement of pore pressure in the groundwater during a time period and / or in several depths. the pore pressure is the pressure in the pore water given as force per area unit, with the atmospheric pressure as reference</engelsk>"
  feature PoretrykkMåling $alias="PorePressureSounding" extends GeotekniskInsituTest {
  "tidspunktet poretrykksmåleren ble installert<engelsk>time of installation of the pore pressure device</engelsk>"
    installasjonTidspunkt?: DateTime
  "lengde på  filter i poretrykksmåler [m]<engelsk>length of filter in the pore pressure device</engelsk>"
    filterLengde?: Real $alias="filterLength"
  "kotenivå for spiss av poretrykksmåler [m]<engelsk>elevation for the tip of the pore pressure device</engelsk>"
    koteSpiss?: Real $alias="depthPointFilter"
  "type filter i poretrykksmåler<engelsk>type of filter in the pore pressure device</engelsk>"
    filterType?: CharacterString $alias="filterType"
  "høyde z-verdi ved filterets topp i forhold til vertikal referanse[m]\r\n\r\n<engelsk>\r\nheight Z-level at the top of filter in relation to vertical reference  (m)  </engelsk>"
    rørToppFilter?: Real $alias="topOfTube"
  "høyde z-verdi ved slangens topp i forhold til vertikal referanse [m] \r\n\r\n<engelsk>\r\nheight Z-level at the top of tube in relation to vertical reference (m)  </engelsk>"
    rørToppSlange?: Real
  "høyde z-verdi ved rørets topp i forhold til vertikal referanse [m] \r\n\r\n<engelsk>\r\nheight Z-level at the top of pipe in relation to vertical reference (m) </engelsk>"
    rørTopp?: Real $alias="topOfTube"
  "høyde z-verdi ved rørets bunn i forhold til vertikal referanse [m]\r\n\r\n<engelsk>\r\nheight Z-level at the bottom of pipe in relation to vertical reference  (m) </engelsk>"
    rørBunn?: Real $alias="bottomOfTube"
  "identifikasjon av poretrykksmåler/måleapparat<engelsk>identification of the pore pressure device/measuring unit</engelsk>"
    målerspissNummer?: CharacterString $alias="measurePointNumber"
  "kategori poretrykksmåler (åpen, hydraulisk, elektrisk<engelsk>cathegory of the pore pressure device (open, hydraulic, electrical</engelsk>"
    målerKategori?: PoretrykkMåleKategori $alias="measureType"
  "type poretrykksmåler (fabrikat, produsent)<engelsk>type of pore pressure device</engelsk>"
    målerType?: CharacterString $alias="measureType"
  poretrykkObservasjon*: PoretrykkData
}

"geoteknisk prøvetaking hvor en sylinder slås ned i fast lagrede masser <engelsk>geotechnical sampling where a sylinder is rammed into compact soil</engelsk>"
  feature RamPrøve $alias="PercussionSample" extends GeotekniskPrøvetaking {
}

"sedimentprøve<engelsk>sediment sample</engelsk>"
  feature SedimentPrøve $alias="SedimentSample" extends GeotekniskPrøvetaking {
}

"geoteknisk prøvetaking for opptak av omrørte prøver <engelsk>geotechnical sampling where disturbed samples are colleced</engelsk>"
  feature SkovlPrøve $alias="BucketSample" extends GeotekniskPrøvetaking {
}

"sonderingstype som brukes for å bestemme lagdeling i løsmasser og dybde til fast grunn, og utføres med en konstant nedpressingshastighet og rotasjonshatighet.<engelsk>sounding method used for identification of soil stratification and depth to firm layers, performed with constant penetration and rotation rate</engelsk>"
  feature StatiskSondering $alias="StaticSounding" extends GeotekniskSondering {
  "dybde for angivelse av telefront ved sondering i frosset jord [m] <engelsk>depth to frost front for sounding in frozen soils </engelsk>"
    telenivå?: Real $alias="groundFrostDepth"
  statiskSonderingObservasjon*: StatiskSonderingData
}

"geoteknisk prøvetaking hvor en sylinder slås ned i fast lagrede masser, og hvor sylinder holdes stengt inntil ønsket dybde\r\n<engelsk>geotechnical sampling where a sylinder is rammed into compact soil, and where the sylinder is kept closed until the desired depth</engelsk>"
  feature StempelPrøve $alias="PistonSample" extends GeotekniskPrøvetaking {
}

"penetrasjon av en trykksonde på enden av en serie med sylindriske trykksonderingsstenger ned i grunnen med konstant hastighet, brukes for å bestemme lagdeling og jordart i løsmasser, samt mekaniske egenskaper for jorden<engelsk>penetration of a probe at the end of a series with cylindrical rods into the ground at the constant rate of penetration, used to determine stratification and soil type, together with mechanical properties of the soil</engelsk>"
  feature Trykksondering $alias="PenetrationTest" extends GeotekniskInsituTest {
  "arealforhold for trykksonde for korreksjon av målt spissmotstand for poretrykkseffekter<engelsk>area ratio for CPT probe for correction of measured cone resistance for pore pressure effects</engelsk>"
    alpha?: Real
  "øvrige faktorer for korreksjon av trykksonderingsdata, for eksempel korreksjon av målt sidefriksjon<engelsk>other factors for correction of CPT data, for example correction of measured sleeve friction</engelsk>"
    cptKorreksjonsFaktor?: Real $alias="initialFrictionalResistance (?)"
  "type filter for måling av poretrykk (porøst filter, ferdigmettet, spaltefilter)<engelsk>type of filter for measurement of pore pressure (porous filter, pre-saturated filter, slot filter)</engelsk>"
    filterType?: CharacterString $alias="filterType"
  "referanseverdi for spissmotstand ved start av måling (eksempel ved start dissipasjonstest) [MPa] <engelsk>reference value cone resistance at the start of the test (e.g. at the start of a dissipation test)</engelsk>"
    initiellSpissmotstand?: Real $alias="initialPointPressure"
  "medium som benyttes for metting av målesystem for poretrykk<engelsk>medium used for saturation of measuring system for pore pressure</engelsk>"
    metningsMedium?: CharacterString $alias="saturationMedium"
  "kapasitet for anvendt nedpressingsutstyr [kN] <engelsk>capacity for applied thrust machine</engelsk>"
    nedpressingsKapasitet?: NedpressingsKapasitet
  "nedpressingshastighet ved penetrasjon av trykksonderingsstenger (standard er 20 mm/s ± 5 mm/s) [mm/s] <engelsk>rate of penetration for rod system (standard is 20 mm/s ± 5 mm/s)</engelsk>"
    nedpressningsHastighet?: Real $alias="rateOfPenetration"
  "korreksjon for registrert nullpunktsavvik før og etter sondering <engelsk>correction for recorded zero load drift before and after sounding</engelsk>"
    nullpunktsKorreksjon?: Real $alias="initialPorePressure, zeroPointCorrection,"
  "korreksjonsfaktor for bruk av friksjonsreduksjonsring <engelsk>correction factor for use of friction reducer</engelsk>"
    rørKappeKorreksjonsFaktor?: Real $alias="mantelareaFaktor,sleeveAreaFactor"
  "korreksjon av målt sidefriksjon på grunn av poretrykkseffekter<engelsk>correction of measured sleeve friction due to pore pressure effects</engelsk>"
    sidefriksjonKorreksjon?: Real $alias="sideFrictionCorrection"
  "identifikasjon av trykksonde ved hjelp av ID-nummer <engelsk>identification of probe by an ID-number</engelsk>"
    sondeIdentifikasjon?: CharacterString
  "dato for kalibrering av trykksonde, oppgis på kalibreringssertifikat<engelsk>date for calibration of probe, given on the calibration certificate</engelsk>"
    sondeKalibreringDato?: DateTime
  "kvalitetsklasse for målenøyaktighet for en trykksonde ved gjennomføring av anbefalt prøvingsprosedyre <engelsk>application class for test accuracy for test performance according to a recommended test procedure</engelsk>"
    sondeKvalitetKlasse?: SondeKvalitetsKlasse
  "korreksjonsfaktor for trykksonde ved korreksjon av målt spissmotstand for poretrykkseffekter<engelsk>correction factor for measured cone resistance for pore pressure effects</engelsk>"
    spissKorreksjonFaktor?: Real $alias="pointAreaFactor"
  "type trykksonde, avhengig av størrelse og instrumentering<engelsk>type of probe, depending on size and instrumentation</engelsk>"
    spissType?: CharacterString $alias="pointType"
  "<engelsk>Gets or sets the atmospheric pressure correction [MPa].\r\n@value The atmospheric pressure correction.</engelsk>"
    atmosferiskTrykkKorreksjon?: Real $alias="AtmosphericPressureCorrection"
  "<engelsk>Gets or sets the sleeve distance correction [m].\r\n@value The sleeve distance correction.</engelsk>"
    hylseRadieKorreksjon?: Real $alias="sleeveDistanceCorrection"
  inSituPoretrykkObservasjon*: PoretrykkDataInsitu
  trykksonderingObservasjon*: TrykksonderingData
  dissipasjonObservasjon*: DissipasjonData
}

"vannprøve<engelsk>water sample</engelsk>"
  feature VannPrøve $alias="WaterSample" extends GeotekniskPrøvetaking {
  "angir kilden til vannprøve<engelsk>define the source of the water sample</engelsk>"
    vannPrøveType?: VannPrøveKilde
}

"undersøkelse for måling av in situ udrenert skjærfasthet for uforstyrret og omrørt materiale i kohesjonsjordarter<engelsk>investigation for measurements of in situ undrained shear strength for undisturbed and remoulded material in cohesive soils</engelsk>"
