package no.ngu.nadag.generelle_typer

import geoforge.lib

"Unik identifikasjon av et objekt, ivaretatt av den ansvarlige produsent/forvalter, som kan benyttes av eksterne applikasjoner som referanse til objektet. \r\n\r\nNOTE1 Denne eksterne objektidentifikasjonen må ikke forveksles med en tematisk objektidentifikasjon, slik som f.eks bygningsnummer. \r\n\r\nNOTE 2 Denne unike identifikatoren vil ikke endres i løpet av objektets levetid."
  datatype Identifikasjon $alias="Identification" {
  "lokal identifikator, tildelt av dataleverendør/dataforvalter. Den lokale identifikatoren er unik innenfor navnerommet, ingen andre objekter har samme identifikator.\r\n\r\nNOTE: Det er data leverendørens ansvar å sørge for at denne lokale identifikatoren er unik innenfor navnerommet."
    identity lokalId: CharacterString $alias="localId"
  "navnerom som unikt identifiserer datakilden til objektet, starter med to bokstavs kode jfr ISO 3166. Benytter understreking  (\"_\") dersom data produsenten ikke er assosiert med bare et land.\r\n\r\nNOTE 1 : Verdien for nanverom vil eies av den dataprodusent som har ansvar for de unike identifikatorene og vil registreres i \"INSPIRE external  Object Identifier Namespaces Register\"\r\n\r\nEksempel: NO for Norge."
    navnerom: CharacterString $alias="namespace"
  "identifikasjon av en spesiell versjon av et geografisk objekt (instans), maksimum lengde på 25 karakterers. Dersom spesifikasjonen av et geografisk objekt med en identifikasjon inkludererer livsløpssyklusinformasjon, benyttes denne versjonId for å skille mellom ulike versjoner av samme objekt. versjonId er en unik  identifikasjon av versjonen. \r\n\r\nNOTE Maksimum lengde er valgt for å tillate tidsregistrering i henhold til  ISO 8601, slik som  \"2007-02-12T12:12:12+05:30\" som versjonId."
    versjonId?: CharacterString $alias="versionId"
}

"angivelse av at objektet er hentet fra en kopi av originaldata\r\n\r\nMerknad: \r\nKan benyttes dersom man gjør et uttak av en database som ikke inneholder originaldataene."
  datatype Kopidata {
  "identifikasjon av område som dataene dekker\r\n\r\nMerknad: Kan angis med kommunenummer eller fylkesnummer. Disse bør spesifiseres nærmere."
    områdeId: Integer
  "ansvarlig etat for forvaltning av data"
    originalDatavert: CharacterString
  "dato når objektet ble kopiert fra originaldatasettet  \r\n\r\nMerknad:\r\nEr en del av egenskapen Kopidata. Brukes i de tilfeller hvor en kopidatabase brukes til distribusjon.\r\nÅ kopiere et datasett til en kopidatabase skal ikke føre til at Oppdateringsdato blir endret.\r\nEventuell redigering av data i et kopidatasett medfører ny Oppdateringsdato, Datafangstdato og/eller Verifiseringsdato."
    kopidato: DateTime
}

"metode som ligger til grunn for registrering av posisjon\r\n\r\n\r\n-- Definition - - \r\nmethod on which registration of position is based"
  codelist Målemetode $alias="MeasuringMethod" {
  Terrengmålt $alias="Measured in terrain"
  Totalstasjon $alias="Total station"
  Teodolitt_med_elektronisk_avstandsmåler $alias="Theodolite with electronic rangefinder"
  Teodolitt_med_målebånd $alias="Theodolite with measuring tape"
  Ortogonalmetoden $alias="Orthogonal method"
  "Punkt beregnet på bakgrunn av andre punkter, slik som to avstander eller avstand + retning\r\n\r\n-- Definition -- \r\nPoint calculated on the basis of other items, such as two distances or distance + direction."
    Utmål $alias="MeasureOut"
  Tatt_fra_plan $alias="Taken from plan"
  "Annet"
    Annet_denne_har_ingen_mening_bør_fjernes_
  Stereoinstrument $alias="Stereo instrument"
  "(Pkt. beregnet v/ aerotriangulering)\r\n\r\n-- Definition -- \r\nPoint calculated by aerotriangulation"
    Aerotriangulert $alias="Aerotriangulated"
  Analytisk_plotter $alias="Analytical plotter"
  Autograf_vanlig_registrering $alias="Autograph - normal registration"
  Digitalt_stereoinstrument $alias="Digital stereo instrument"
  Scannet_fra_kart $alias="Scanned from map"
  Scannet_fra_blyantoriginal $alias="Scannet from pencilled original"
  Scannet_fra_rissefolie $alias="Scanned from ??scribing folio"
  Scannet_fra_transparent_folie_god_kvalitet $alias="Scanned from transparency folio - good quality"
  Scannet_fra_transparent_folie_mindre_god_kvalitet $alias="Scanned from transparency folio - inferior quality"
  Scannet_fra_papirkopi $alias="Scannet from paper / hard copy"
  Flybåren_laserscanner $alias="Airbourne laser scanner"
  Digitalisert_på_dig_bord_fra_ortofoto_flybilde $alias="Digitised on dig.table from orthophoto/aerial photo"
  Digitalisert_fra_ortofoto_film $alias="Digitised from orthophoto - film"
  Digitalisert_fra_ortofoto_fotokopi $alias="Digitised from orthophoto - photocopy"
  Digitalisert_fra_flybilde_monodigitalisert_fra_film $alias="Digitised from aerial photo - mono-digitised from film"
  Digitalisert_fra_flybilde_monodigitalisert_fra_fotokopi $alias="Digitised from aerial photo - mono-digitised from photocopy"
  Digitalisert_fra_ortofoto $alias="Digitised from orthophoto"
  Digitalisert_på_skjerm_fra_satellittbilde $alias="Digitised on screen from satellite photo"
  Digitalisert_på_dig_bord_fra_strek_kart $alias="Digitised on dig.table from line-map"
  Digitalisert_på_dig_bord_fra_blyantoriginal $alias="Digitised on dig.table from pencilled original"
  Digitalisert_på_dig_bord_fra_rissefolie $alias="Digitised on dig.table from ??scribing folio"
  Digitalisert_på_dig_bord_fra_transparent_film_god_kvalitet $alias="Digitised on dig.table from transparency film - good quality"
  Digitalisert_på_dig_bord_fra_transparent_film_mindre_god_kvalitet $alias="Digitised on dig.table from transparency film - lower quality"
  Digitalisert_på_dig_bord_fra_papirkopi $alias="Digitised on dig.table from paper copy"
  "(Raster)"
    Dig_på_skjerm_fra_scannet_samkopi $alias="Digitised on screen from scanned photographic combination"
  Genererte_data_interpolasjon_ $alias="Generated data (interpolation)"
  Generert_i_terrengmodell $alias="Generated in terrain model"
  Vektet_middel $alias="Weighted mean"
  Generert_sirkelgeometri $alias="Generated circular geometry"
  Generalisert $alias="Generalised"
  Generert_sentralpunkt $alias="Generated central point"
  Sammenknytningspunkt_randpunkt $alias="Connection point/edge point"
  Koordinater_hentet_fra_GAB $alias="Coordinates retrieved from GAB"
  Koordinater_hentet_fra_JREG $alias="Coordinates retrieved from JREG"
  Beregnet $alias="Calculated"
  Spesielle_metoder $alias="Special methods"
  Målt_med_stikkstang $alias="Measured with range pole"
  Målt_med_waterstang $alias="Measured with"
  Målt_med_målehjul $alias="Measured with measuring wheel"
  Målt_med_stigningsmåler $alias="Measured with rate of climb indicator"
  "punkt fastsatt ut fra et grunnlag f.eks ved partenes enighet ved oppmålingsforretning."
    Fastsatt_punkt
  Fastsatt_ved_dom_eller_kongelig_resolusjon $alias="Stipulated by court decision or royal decree"
  "Annet (spesifiseres i filhode)"
    Annet_spesifiseres_i_filhode_bør_vel_fjernes_blir_borte_ved_overføring_mellom_systemer_ $alias="????"
  Frihåndstegning $alias="Free-hand drawing"
  Digitalisert_fra_krokering_på_kart $alias="Digitised from sketching on map"
  Direkte_innlagt_på_skjerm $alias="Directly input on screen"
  Treghetsstedfesting $alias="Inertial ??positioning/localization"
  "Tidligere GPS-Differensiell, pseudorange\r\n\r\n-- Definition -- \r\nPrevious GPS differential, pseudorange"
    GPS_Kodemåling_relative_målinger $alias="GPS code measurement, relatively measurements"
  "Tidligere GPS, Absolutt, pseudorange\r\n\r\n-- Definition -- \r\nPrevious GPS, absolute, pseudorange"
    GPS_Kodemåling_enkeltmålinger $alias="GPS code measurement, individual measurements"
  "Tidligere GPS, Differensiell\r\n\r\n-- Definition -- \r\nPrevious GPS, differential"
    GPS_Fasemåling_statisk_måling $alias="GPS phase measurement, static measurement"
  "(utenom RTK). Tidligere GPS-Absolutt, fase\r\n\r\n-- Definition -- \r\n(not including RTK). Previous Absolute GPS, phase"
    GPS_Fasemåling_andre_metoder $alias="GPS phase measurement, other methods"
  Kombinasjon_av_GPS_Treghet $alias="Combination of GPS/Inertia"
  "(Realtids kinematisk måling). Tidligere GPS kinematisk (Real time kinematic)\r\n\r\n-- Definition -- \r\n(Real time kinematic measurement). Previous GPS kinematic (Real time kinematic)"
    GPS_Fasemåling_RTK $alias="GPS phase measurement RTK"
  GPS_Fasemåling_float_løsning $alias="GPS phase measurement, float solution"
  Ukjent_målemetode $alias="Unknown measurement method"
}

"metode for å måle objekttypens høydeverdi"
  codelist MålemetodeHøyde {
  Terrengmålt
  Totalstasjon
  Teodolitt_med_elektronisk_avstandsmåler
  Teodolitt_med_målebånd
  Ortogonalmetoden
  Nivellement
  Tatt_fra_plan
  Annet
  Stereoinstrument
  Aerotriangulert
  Analytisk_plotter
  Autograf_vanlig_registrering
  Digitalt_stereoinstrument
  Flybåren_laserscanning
  Genererte_data_interpolasjon_
  Generert_i_terrengmodell
  Vektet_middel
  Generert_sirkelgeometri
  Generalisert
  Sammenknytningspunkt_randpunkt
  Koordinater_hentet_fra_GAB
  Koordinater_hentet_fra_JREG_
  Beregnet_
  Spesielle_metoder
  Målt_med_stigningsmåler
  Fastsatt_ved_dom_eller_kongelig_resolusjon
  Annet_spesifiseres_i_filhode_
  Treghetsstedfesting
  GPS_Kodemåling_relative_målinger_
  GPS_Kodemåling_enkeltpunktbestemmelser
  GPS_Fasemåling_statisk_måling_
  GPS_Fasemåling_andre_metoder
  Kombinasjon_av_GPS_Treghet
  GPS_Fasemåling_RTK
  Ukjent_målemetode
}

"beskrivelse av kvaliteten på stedfestingen"
  datatype Posisjonskvalitet {
  "metode for måling i grunnriss (x,y), og høyde (z) når metoden er den samme som ved måling i grunnriss"
    målemetode: Målemetode
  "punktstandardavviket i grunnriss for punkter samt tverravvik for linjer\r\n\r\nMerknad:\r\nOppgitt i cm"
    nøyaktighet?: Integer
  "hvor godt den kartlagte detalj var synbar ved kartleggingen"
    synbarhet?: Synbarhet
  "metode for å måle høyden"
    målemetodeHøyde?: MålemetodeHøyde
  "nøyaktighet for høyden i cm"
    nøyaktighetHøyde?: Integer
  "absolutt toleranse for geometriske avvik"
    maksimaltAvvik?: Integer
}

"hvor godt den kartlagte detalj var synbar ved kartleggingen"
  codelist Synbarhet {
  "Default"
    Fullt_ut_synlig_gjenfinnbar_i_terrenget
  "Forøvrig grei å innmåle. (Benyttes bl.a. for innmåling av ledninger på lukket grøft)"
    Dårlig_gjenfinnbar_i_terreng
  "Middels synlig i flybilde/modell"
    Middels_synlig_i_flybilde_modell
  "Dårlig/ikke synlig i flybilde/modell"
    Dårlig_ikke_synlig_i_flybilde_modell
}
