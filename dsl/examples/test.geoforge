model ngu.nadag

import geoforge.lib

codelist HoleType {
  UNKNOWN = 0
  DRILLED = 1
}

feature GeotekniskUnders {
  identity identifikasjon : Identifikasjon
  geometry område: Areal
  borehull*: GB
}

feature GB {
    identity identifikasjon : Identifikasjon
    holeType: HoleType
    opprettetDato: Date
    geometry posisjon: Posisjon
}