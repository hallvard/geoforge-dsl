    målemetodeHøyde?: MålemetodeHøyde
  "punktstandardavviket i grunnriss for punkter samt tverravvik for linjer\r\nMerknad:\r\nOppgitt i [cm]"
    nøyaktighet?: Integer
  "nøyaktighet for høyden i [cm]"
    nøyaktighetHøyde?: Integer
}

"innsamlede data for utførelse og registrering ved gjennomføring av statisk sondering <engelsk>collected data for performance and recordings in static sounding</engelsk>"
  datatype StatiskSonderingData $alias="StaticSoundingData" {
  "anvendt nedpressingskraft registrert på overflaten under sonderingen [kN] <engelsk>applied penetration force recorded on the surface during sounding</engelsk>"
    anvendtlast?: Real $alias="appliedLoad"
  "boret dybde i forhold til terrengoverflaten eller annet angitt referansenivå [m] <engelsk>drilled depth related to the terrain surface or any other given reference level</engelsk>"
    boretLengde: Real $alias="depth"
  "antall halve omdreininger av stangsystemet, regnet fra forrige dybde <engelsk>number of half turns of the rod system, referring to the previous depth</engelsk>"
    halveOmdreininger?: Real $alias="halfTurns"
  "markering av slag på borstrengen under sonderingen<engelsk>marking of strokes on the drill rods during sounding</engelsk>"
    medSlag?: Boolean $alias="hasPiling"
  "tidsregistrering under nedpressing av stangsystemet, målt per meter [sek/m] <engelsk> time record during penetration of the rod system, referring to the previous depth </engelsk>"
    nedpressingTid?: Integer $alias="penetrationTime"
  "nedpressing av stangsystemet per tidsenhet [m/min] <engelsk>penetration of the rod system per unit time (rate of penetration)  </engelsk>"
    nedsynkningHastighet?: Real $alias="rateOfPiling"
  "observasjonskoder for markering av hendelser i sonderingen. Kodene er (0..*) tallkoder gitt i en tekststreng med mellomrom mellom hver kode hvis mer enn 1. Kodene er beskrevet i kodelisten GeotekniskBoreObservasjonskode. \r\n<engelsk>observation codes for marking of incidents during sounding. The codes are (0..*) numeric codes given in a text string with spaces between each code if more than 1. The codes are described in the code list GeotekniskBoreObservasjonskode. </engelsk>"
    observasjonKode?: CharacterString $alias="remarkCode"
  "merknad til observasjoner i sonderingen<engelsk>remarks to observations made during sounding</engelsk>"
    observasjonMerknad?: CharacterString $alias="remark"
  "antall omdreininger av stangsystemet per tidsenhet ved penetrasjon av borstrengen [omdr/min] <engelsk>number of turns of the rod system per time unit, during penetration of the drill string</engelsk>"
    rotasjonHastighet?: Real $alias="rateOfTurning"
  "<engelsk>Gets or sets the has turning, that indicates if rotation is logged while penetration of soil.\r\n@value The has turning.</engelsk>"
    harRotasjon?: Boolean $alias="hasTurning"
  "<engelsk>Gets or sets the sleeve friction, the measured sleeve friction during penetration of the probe (friction sleeve force divided by area of the friction sleeve [kPa].</engelsk>"
    sideFriksjon?: Real $alias="sleeveFriction"
  "slagfrekvens ved anvendelse av slag på borstrengen i fjellkontrollmodus, angitt ved antall slag per tidsenhet [slag/m]"
    slagFrekvens?: Real $alias="rateOfPiling"
}

"data fra utførelse av trykksondering (med poretrykksmåling) CPT(U)<engelsk>data fra performance of cone penetration test (with pore pressure measurements) CPT(U)</engelsk>"
  datatype TrykksonderingData $alias="PressureSoundingData" {
  "anvendt last på overflaten for nedpressing av trykksonde med stenger [kN] <engelsk>applied thrust load on the surface for penetration of the test rods and probe</engelsk>"
    anvendtLast?: Real $alias="appliedLoad"
  "boret dybde i forhold til terrengoverflaten eller annet angitt referansenivå [m] <engelsk>depth below the terrain surface or any other given reference level</engelsk>"
    boretDybde?: Real $alias="depth"
  "lengde langs borehullets forløp, tilsvarer dyp ved vertikal boring [m] <engelsk>length along the physical borehole, the same as depth in a vertical borehole</engelsk>"
    boretLengde: Real $alias="depth"
  "målt sidefriksjon ved nedpressing av trykksonde (friksjonskraft dividert med areal av friksjonshylse) [kPa] <engelsk>measured sleeve friction during penetration of the probe (friction sleeve force divided by area of the friction sleeve)</engelsk>"
    friksjon?: Real $alias="frictionalresistance"
  "vinkelavvik mellom nedpressingsretning for trykksonde og vertikalaksen [°] <engelsk>deviation between the penetration axis and the vertical axis</engelsk>"
    helning?: Real $alias="inclination,slope"
  "initielt poretrykk ved start av dissipasjonstest i CPTU [kPa] <engelsk>initial pore pressure at the start of the dissipation test in CPTU</engelsk>"
    initieltPoretrykk?: Real $alias="initialPorePressure"
  "elektrisk motstand når den går gjennom et materiale, måles ved gjennomføring av RCPTU-forsøk. Måles i [Ωm] (ohm-meter). <engelsk>electrical resistivity, measured in a RCPTU-test (?m) </engelsk>"
    resistivitet?: Real $alias="resistivity"
  "korrigert sidefriksjon ved nedpressing av trykksonde (friksjonskraft dividert med areal av friksjonshylse, korrigert for poretrykkseffekter) [MPa] <engelsk>corrected sleeve friction during penetration of the probe (friction sleeve force divided by area of the friction sleeve, corrected for pore pressure effects)</engelsk>"
    korrigertFriksjon?: Real $alias="correctedFrictionalResistance"
  "korrigert last på overflaten for nedpressing av trykksonde med stenger [kN] <engelsk>corrected load on the surface for penetration of the test rods and probe</engelsk>"
    korrigertNedpressningsKraft?: Real $alias="correctedPointPressure"
  "nedpressingsdistanse for trykksonde per tidsenhet (standard er 2 cm/sek) [m/min] <engelsk>penetration rate for probe (2 cm/sec)</engelsk>"
    nedpressingHastighet?: Real $alias="rateOfPenetration"
  "anvendt last på overflaten for nedpressing av trykksonde med stenger [kN] <engelsk>applied thrust load on the surface for penetration of the test rods and probe</engelsk>"
    nedpressingsKraft?: Real $alias="rateOfPenetration"
  "tid for nedpressing av sonden til ønsket eller annen angitt dybde, regnet fra forrige dybde [sek]\r\n<engelsk>time for penetration of the probe to the requested or any other given depth. Referring to the previous depth</engelsk>"
    nedpressingsTid?: Integer $alias="penetrationTime"
  "observasjonskoder for markering av hendelser i trykksonderingen. Kodene er (0..*) tallkoder gitt i en tekststreng med mellomrom mellom hver kode hvis mer enn 1. Kodene er beskrevet i kodelisten GeotekniskBoreObservasjonskode.  <engelsk>observation codes for marking of incidents during penetration. The codes are (0..*) numeric codes given in a text string with spaces between each code if more than 1. The codes are described in the code list GeotekniskBoreObservasjonskode. </engelsk>"
    observasjonKode?: CharacterString $alias="remarkCode"
  "merknad til observasjoner i trykksonderingen <engelsk>remarks to observations made during penetration</engelsk>"
    observasjonMerknad?: CharacterString $alias="remark"
  "vanntrykket i porevannet i grunnen, med atmosfæretrykket som referanse [kPa] <engelsk>the pressure in the pore water, with the atmospheric pressure as reference</engelsk>"
    poretrykk?: Real $alias="porePressure"
  "hastighet til s-bølge [m/s] <engelsk>velocity of s-wave</engelsk>"
    skjærbølgeHastighet?: Real
  "temperatur i jord og/eller luft ved gjennomføring av trykksonderingen [°C] <engelsk>temperature in soil and/or air during the testing</engelsk>"
    temperatur?: Real $alias="temperature"
  "målt spissmotstand ved nedpressing av trykksonde (spisskraft dividert med tverrsnittsareal av trykksonde) [MPa] <engelsk>measured cone resistance during penetration of the probe (point load divided by cross-sectional area of probe) [MPa].</engelsk>"
    nedpressingTrykk?: Real $alias="PenetrationPressure"
}

"data fra utførelse og tolkning av vingeboring<engelsk>data from performance and interpretation of vane tests</engelsk>"
  datatype VingeboringData $alias="VaneTestData" {
  "boret dybde i forhold til terrengoverflaten eller annet angitt referansenivå [m] <engelsk>depth below the terrain surface or any other given reference level</engelsk>\r\n<engelsk> depth from zero level, the z value of investigation start point is 0. drilling depth[m]</engelsk>"
    boretDybde?: Real $alias="depth"
  "densitet for jordlagene, redusert for oppdriftseffekter [kg/m3] <engelsk>density for soil layers, reduced for buoyancy effects</engelsk>"
    effektivDensitet?: Real $alias="effectiveDensity"
  "skjærfasthet korrigert for plastisitet og effektivt overlagringstrykk [kPa] <engelsk>shear strength corrected for plasticity and effective overburden stress</engelsk>"
    korrigertSkjærfasthet?: Real $alias="correctedShearStrength"
  "observasjonskoder for markering av hendelser i vingeboringen. Kodene er (0..*) tallkoder gitt i en tekststreng med mellomrom mellom hver kode hvis mer enn 1. Kodene er beskrevet i kodelisten GeotekniskBoreObservasjonskode.\r\n<engelsk>observation codes for marking of incidents during vane testing. The codes are (0..*) numeric codes given in a text string with spaces between each code if more than 1. The codes are described in the code list GeotekniskBoreObservasjonskode.</engelsk>"
    observasjonKode?: CharacterString $alias="remarkCode"
  "merknad til observasjoner i vingeboringen\r\n<engelsk>remarks to observations made during vane testing</engelsk>"
    observasjonMerknad?: CharacterString
  "skjærfasthet for en kohesjonsjordart med fullstendig omrørt struktur [kPa] <engelsk>shear strength for a cohesive soil with completely remoulded structure</engelsk>"
    omrørtSkjærfasthet?: Real $alias="disturbedShearStrength"
  "målt vridningsmoment ved måling av vingeborrotasjon i en kohesjonsjordart med fullstendig omrørt struktur [kNm] <engelsk>measured torque during vane rotation in cohesive soil with completely remoulded structure</engelsk>"
    omrørtTorsjonMoment?: Real $alias="disturbedTorsionMoment"
  "forholdet mellom uforstyrret og omrørt udrenert skjærfasthet for kohesjonsjord  <engelsk>ratio between undisturbed and remoulded undrained shear strength for cohesive soil</engelsk>"
    sensitivitet?: Real $alias="sensitivity"
  "skjærfasthet for en kohesjonsjordart med uforstyrret, intakt struktur [kPa] <engelsk>shear strength for a cohesive soil with intact, undisturbed structure</engelsk>"
    uomrørtSkjærfasthet?: Real $alias="undisturbedShearStrength"
  "målt vridningsmoment ved måling av vingeborrotasjon i en kohesjonsjordart med uforstyrret, intakt struktur [kNm] <engelsk>measured torque during vane rotation in cohesive soil with intact, undisturbed structure</engelsk>"
    uomrørtTorsjonMoment?: Real $alias="undisturbedTorsionMoment"
  "total lengde av borehullets forløp, tilsvarer dyp ved vertikal boring [m] <engelsk>total length of the investigation in the physical borehole, the same as depth in a vertical borehole</engelsk>"
    boretLengde: Real $alias="length"
  "Numerisk forskjell mellom flyte- og plastisitetsgrense for finstoffholdige jordarter, angir utstrekningen på det plastiske området for jordarten i prosent vanninnhold [%] <engelsk>Gets or sets the index of the plasticy, the difference between the liquid and plastic limits for a remoulded clay sample, which defines the plastic area of the clay in % water content </engelsk>"
    plastisitetIndeks?: Real $alias="plasticyIndex"
}
